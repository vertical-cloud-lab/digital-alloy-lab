@article{tammpere_2024_adem2023,
  author = {Tammpere, Hannes and McKeown, Phil and Miller, James and Fang, Chizhou and Curtis, Emily and Gaiser‐Porter, Marcus and Burley, Max and Campbell, James and Artiles, Maria and Tang, Yuanbo and Utada, Satoshi and Reed, Roger and Clyne, Trevor},
  title = {Profilometry‐Based Indentation Plastometry at High Temperature},
