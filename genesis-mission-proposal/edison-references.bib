  pages = {133--156},
  publisher = {CRC Press},
  doi = {10.1201/9780429436543-6},
  url = {https://doi.org/10.1201/9780429436543-6},
  abstract = {This chapter presents an overview of the current status with specification standards for additive manufacturing. While many of the currently used standards have been adopted from those currently used for more traditional processes and applications, there is a growing demand for more directly relevant standards to be developed and adopted. The chapter will cover the standardisation activities as well as current standards for feedstock and part characterisation, along with gaps that have been identified and are currently being addressed.},
}

