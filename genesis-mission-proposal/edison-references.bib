  author = {Schmid-Fetzer, R. and Andersson, D. and Chevalier, P.Y. and Eleno, L. and Fabrichnaya, O. and Kattner, U.R. and Sundman, B. and Wang, C. and Watson, A. and Zabdyr, L. and Zinkevich, M.},
  title = {Assessment techniques, database design and software facilities for thermodynamics and diffusion},
