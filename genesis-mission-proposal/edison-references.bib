@article{hyer_2020_s1363202,
  author = {Hyer, Holden and Zhou, Le and Park, Sharon and Gottsfritz, Guilherme and Benson, George and Tolentino, Bjorn and McWilliams, Brandon and Cho, Kyu and Sohn, Yongho},
  title = {Understanding the Laser Powder Bed Fusion of AlSi10Mg Alloy},
  journal = {Metallography, Microstructure, and Analysis},
  year = {2020},
  month = {8},
  volume = {9},
  number = {4},
  pages = {484--502},
  publisher = {Springer Science and Business Media LLC},
