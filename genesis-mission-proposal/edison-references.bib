}

@article{wang_2020_ma132045,
  author = {Wang, Zhi and Ummethala, Raghunandan and Singh, Neera and Tang, Shengyang and Suryanarayana, Challapalli and Eckert, Jürgen and Prashanth, Konda Gokuldoss},
  title = {Selective Laser Melting of Aluminum and Its Alloys},
  journal = {Materials},
  year = {2020},
  month = {10},
  volume = {13},
  number = {20},
  pages = {4564},
  publisher = {MDPI AG},
  doi = {10.3390/ma13204564},
  url = {https://doi.org/10.3390/ma13204564},
  issn = {1996-1944},
  abstract = {The laser-based powder bed fusion (LBPF) process or commonly known as selective laser melting (SLM) has made significant progress since its inception. Initially, conventional materials like 316L, Ti6Al4V, and IN-718 were fabricated using the SLM process. However, it was inevitable to explore the possible fabrication of the second most popular structural material after Fe-based alloys/steel, the Al-based alloys by SLM. Al-based alloys exhibit some inherent difficulties due to the following factors: the presence of surface oxide layer, solidification cracking during melt cooling, high reflectivity from the surface, high thermal conductivity of the metal, poor flowability of the powder, low melting temperature, etc. Researchers have overcome these difficulties to successfully fabricate the different Al-based alloys by SLM. However, there exists no review dealing with the fabrication of different Al-based alloys by SLM, their fabrication issues, microstructure, and their correlation with properties in detail. Hence, the present review attempts to introduce the SLM process followed by a detailed discussion about the processing parameters that form the core of the alloy development process. This is followed by the current research status on the processing of Al-based alloys and microstructure evaluation (including defects, internal stresses, etc.), which are dealt with on the basis of individual Al-based series. The mechanical properties of these alloys are discussed in detail followed by the other important properties like tribological properties, fatigue properties, etc. Lastly, an outlook is given at the end of this review.},
}

@article{wang_2020_s1166902,
  author = {Wang, Xin and Sridar, Soumya and Xiong, Wei},
  title = {Thermodynamic Investigation of New High-Strength Low-Alloy Steels with Heusler Phase Strengthening for Welding and Additive Manufacturing: High-Throughput CALPHAD Calculations and Key Experiments for Database Verification},
  journal = {Journal of Phase Equilibria and Diffusion},
  year = {2020},
  month = {12},
  volume = {41},
  number = {6},
