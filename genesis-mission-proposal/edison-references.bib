@misc{maffettone_2023_23041112,
  author = {Phillip M. Maffettone and Pascal Friederich and Sterling G. Baird and B. Blaiszik and Keith A. Brown and S. Campbell and O. Cohen and Tantum Collins and R. Davis and Ian T. Foster and Navid Haghmoradi and M. Hereld and H. Joress and Nicole Jung and Ha-Kyung Kwon and Gabriella Pizzuto and Jacob Rintamaki and Casper Steinmann and Luca Torresi and Shijing Sun},
  title = {{What is missing in autonomous discovery: open challenges for the community}},
  year = {2023},
