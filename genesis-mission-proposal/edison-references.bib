  author = {Kavalsky, Lance and Hegde, Vinay I. and Muckley, Eric and Johnson, Matthew S. and Meredig, Bryce and Viswanathan, Venkatasubramanian},
  title = {By how much can closed-loop frameworks accelerate computational materials discovery?},
