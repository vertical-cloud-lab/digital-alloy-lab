  author = {Santos Macías, Juan Guillermo and Zhao, Lv and Tingaud, David and Bacroix, Brigitte and Pyka, Grzegorz and van der Rest, Camille and Ryelandt, Laurence and Simar, Aude},
  title = {Hot isostatic pressing of laser powder bed fusion AlSi10Mg: parameter identification and mechanical properties},
