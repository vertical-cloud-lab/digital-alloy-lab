  author = {Tali, Ronak and Mishra, Ankush Kumar and Lohia, Devesh and Mauthe, Jacob Paul and Neu, Justin Scott and Kwon, Sung-Joo and Olanrewaju, Yusuf and Balu, Aditya and Trajcevski, Goce and So, Franky and You, Wei and Amassian, Aram and Ganapathysubramanian, Baskar},
