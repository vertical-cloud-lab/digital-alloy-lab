  author = {Shamsdini, SeyedAmirReza and Ghoncheh, M.H. and Mohammadi, Mohsen},
  title = {Effect of recoater-blade type on the mechanical properties and microstructure of additively manufactured maraging steels},
  journal = {Materials Science and Engineering: A},
