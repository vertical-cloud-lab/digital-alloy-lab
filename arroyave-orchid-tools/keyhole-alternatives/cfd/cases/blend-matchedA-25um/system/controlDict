FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
application     laserbeamFoam;
startFrom       latestTime;
startTime       0;
stopAt          endTime;
endTime         1.200000e-03;
deltaT          1e-9;
writeControl    adjustableRunTime;
writeInterval   1.000000e-04;
purgeWrite      0;
writeFormat     ascii;
writePrecision  7;
writeCompression off;
timeFormat      general;
timePrecision   8;
runTimeModifiable yes;
adjustTimeStep  yes;
maxCo           0.3;
maxAlphaCo      0.3;
maxDeltaT       5e-7;
