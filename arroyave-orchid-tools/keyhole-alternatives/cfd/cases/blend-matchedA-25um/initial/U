FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
dimensions      [0 1 -1 0 0 0 0];
internalField   uniform (0 0 0);
boundaryField
{
    lowerWall
    {
        type slip;
    }
    rightWall
    {
        type slip;
    }
    leftWall
    {
        type slip;
    }
    frontAndBack
    {
        type slip;
    }
    atmosphere
    {
        type pressureInletOutletVelocity;
        value uniform (0 0 0);
    }
}
