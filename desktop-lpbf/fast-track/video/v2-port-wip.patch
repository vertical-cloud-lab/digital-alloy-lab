+def optics_move(s, dz):
+    """Slide the gantry cross-beams up the posts with the head, lens, collar and collimator (and the supply, cables and
+    photodiode branch on them); the fibre follows (its FT-1V shape from the model, blended)."""
+    tl = s.tl
+    keys = [k for n, k in s.Am.items() if n.startswith(OPTICS)]
+    keys = [k for k in keys if tl.state(tl.t)[k]["vis"]]
+    fib = [k for n, k in s.Am.items() if n.startswith("Process fibre")]
+    t0 = tl.t
+    Pm = tl.move(keys, [(0, 0, 0), (0, 0, dz)], v=OPTICS_V, a=20, verb="sliding up",
+                 label=[("Gantry cross-beams with the head and lens", "E4, L3, L4, MK-09")])
+    if fib:
+        V1 = S.state_meshes(s.b)["Process fibre"]["V"]
+        if len(V1) == len(tl.actors[fib[0]].V):
+            tl.morph(fib[0], V1, t0, t0 + Pm.T)
+        else:
+            print("  ! fibre mesh changes topology with the head height: drawn rigid", flush=True)
+            tl.move(fib, [(0, 0, 0), (0, 0, dz)], v=OPTICS_V, overlay=False)
+    return Pm
