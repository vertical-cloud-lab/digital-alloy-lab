# Retrieval evaluation set for the NSF requirements snippet store.
#
# Hand-curated query → expected snippet id pairs, used by `run_eval.py` to
# compute Recall@5 and MRR over the BM25 retriever (and any future hybrid /
# dense extensions).
#
# Schema: one JSON object per line.
#   {
#     "query":            "<natural-language question a PI/reviewer might ask>",
#     "expected_id":      "<canonical snippet id that should answer it>",
#     "also_acceptable":  ["<other snippet ids that also count>"],   (optional)
#     "tag":              "<short topic tag>"
#   }
#
# Coverage targets the most common compliance questions for an NSF proposal.
# Per `edison-trajectories/llm-doc-tokenization/result.md` §8 the production
# eval set should grow to 50-100 items; this is the v1 seed (15 items) and
# every `expected_id` was verified to exist in `snippets/snippets.jsonl` at
# build time.
{"query": "What is the page limit on the Project Summary?", "expected_id": "pappg-24-1#II.D.2.b", "tag": "page-limits"}
{"query": "How many pages can the Project Description be?", "expected_id": "pappg-24-1#II.D.2.d.(ii)", "tag": "page-limits"}
{"query": "Are URLs allowed in the Project Description?", "expected_id": "pappg-24-1#II.D.2.d.(ii)", "tag": "url-prohibition"}
{"query": "Should I number the pages of my proposal sections myself?", "expected_id": "pappg-24-1#II.C.1", "tag": "pagination"}
{"query": "What three sections must be in the Project Summary?", "expected_id": "pappg-24-1#II.D.2.b", "tag": "project-summary-structure"}
{"query": "Can the Project Summary be an abstract of the proposal?", "expected_id": "pappg-24-1#II.D.2.b", "tag": "project-summary-structure"}
{"query": "What are the font and margin requirements for an NSF proposal?", "expected_id": "pappg-24-1#II.C.2", "tag": "formatting"}
{"query": "What is required for the biographical sketch in an NSF proposal?", "expected_id": "pappg-24-1#II.D.2.h.(i)", "tag": "biosketch"}
{"query": "What is required for Current and Pending Other Support?", "expected_id": "pappg-24-1#II.D.2.h.(ii)", "also_acceptable": ["pappg-24-1#II.D.2.h.(ii)~p1", "pappg-24-1#II.D.2.h.(ii)~p2"], "tag": "current-and-pending"}
{"query": "When is a Data Management and Sharing Plan required?", "expected_id": "pappg-24-1#II.D.2.i.(ii)", "also_acceptable": ["pappg-24-1#II.D.2.a.(ii)"], "tag": "dmsp"}
{"query": "What are the two NSF merit review criteria?", "expected_id": "pappg-24-1#III.A", "also_acceptable": ["pappg-24-1#III.A.1", "pappg-24-1#III.A.2"], "tag": "merit-review"}
{"query": "Do EAGER proposals require contacting a program officer first?", "expected_id": "pappg-24-1#II.F.3", "tag": "eager"}
{"query": "What is required in the postdoc Mentoring Plan?", "expected_id": "pappg-24-1#II.D.2.i.(i)", "tag": "mentoring-plan"}
{"query": "Can I include cost information in the Facilities, Equipment and Other Resources section?", "expected_id": "pappg-24-1#II.D.2.g", "tag": "facilities"}
{"query": "What happens to a proposal that does not comply with the format requirements?", "expected_id": "pappg-24-1#IV.B", "also_acceptable": ["pappg-24-1#IV.D.2.c"], "tag": "compliance"}

# --- v2 expansion (PR #11 round 4): grow 15 → 55 stratified items ---
# Each new item was hand-validated against snippets/snippets.jsonl. Tags
# cover the 12 most common pre-award compliance topics (page limits,
# format, sections, budgets, sponsored personnel, special information,
# post-award disclosures, merit review, post-submission, special
# proposal types, eligibility, conflicts).

